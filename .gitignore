# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Reference release APK of the original app (recovery source, not tracked)
/app-release.apk

# APK recovery workspace: unpacked APK and derived dumps (reports and screenshots ARE tracked)
/recovery/apk/
/recovery/libapp_strings.txt
/recovery/*.log

# Claude Code local overrides
.claude/settings.local.json
# Captures of our own build are throwaway; only the references to the
# original app are kept (orig-*, theme-*, and the numbered screen tour).
/recovery/screens/*
!/recovery/screens/orig-*
!/recovery/screens/theme-*
!/recovery/screens/[0-9]*
!/recovery/screens/icons-montage.png

# Release signing details and the keystore itself stay out of git
/android/key.properties
*.jks
*.keystore
